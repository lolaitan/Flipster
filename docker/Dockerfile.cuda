# syntax=docker/dockerfile:1
# GPU image. Needs the NVIDIA Container Toolkit on the host:
#   docker build -f docker/Dockerfile.cuda -t flipster:cuda .
#   docker run --gpus all -p 8000:8000 flipster:cuda

FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nvidia/cuda:12.6.3-devel-ubuntu24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-dev cmake ninja-build \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv
ENV PATH=/venv/bin:$PATH
WORKDIR /src
COPY pyproject.toml CMakeLists.txt README.md LICENSE ./
COPY core core
COPY bindings bindings
COPY python python
# No GPU is visible at build time, so target architectures explicitly
# (Turing/Ampere/Ada + PTX so newer cards JIT-compile).
RUN FLIPSTER_ENABLE_CUDA=ON pip install --no-cache-dir ".[server]" \
    --config-settings=cmake.define.CMAKE_CUDA_ARCHITECTURES="75;86;89"

FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 libgomp1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY --from=build /venv /venv
ENV PATH=/venv/bin:$PATH
WORKDIR /app
COPY server server
COPY samples samples
COPY --from=web /web/dist web/dist
ENV FLIPSTER_DATA_DIR=/data \
    FLIPSTER_SAMPLES_DIR=/app/samples/scans \
    FLIPSTER_WEB_DIST=/app/web/dist
VOLUME /data
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--app-dir", "server", "--host", "0.0.0.0", "--port", "8000"]
